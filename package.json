{
  "name": "@golden-jack/cli",
  "version": "1.1.1",
  "description": "Golden Jack CLI",
  "homepage": "https://github.com/Golden-Jack/cli#readme",
  "bugs": {
    "url": "https://github.com/Golden-Jack/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Golden-Jack/cli.git"
  },
  "license": "MIT",
  "author": "Li Koubra",
  "type": "module",
  "main": "src/main.ts",
  "bin": {
    "golden-jack": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "start": "tsx .",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --external:ink --external:react",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@golden-jack/engine": "^1.0.6",
    "env-paths": "^4.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
